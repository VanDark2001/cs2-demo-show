# Copy this file to .env for local development. Never commit the real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=csdemo
MYSQL_USER=csdemo
MYSQL_PASSWORD=change-me
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me
MYSQL_APP_USER_HOST=localhost
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/csdemo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
BACKEND_PORT=8090
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPDATE_STEAM_AVATARS_ON_START=true
STEAM_AVATAR_TIMEOUT_SECONDS=5
STEAM_AVATAR_WORKERS=4
